model <- glm(relevel(factor(cofd$Sex), ref = "Female")~ relevel(factor(cofd$Decade), ref = "2017-2021") + relevel(factor(cofd$Seasons), ref = "Rainy")
+ relevel(factor(cofd$Age_cat), ref = "18+") + relevel(factor(cofd$CofD), ref = "Other"),
